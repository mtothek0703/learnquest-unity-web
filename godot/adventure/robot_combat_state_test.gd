extends SceneTree
const Combat = preload("res://adventure/robot_combat_state.gd")

func _initialize() -> void:
    var combat = Combat.new()
    var warnings := [0]
    var resolved := [0]
    var defeats := [0]
    combat.warning_started.connect(func(): warnings[0] += 1)
    combat.attack_resolved.connect(func(_blocked: bool): resolved[0] += 1)
    combat.robot_defeated.connect(func(): defeats[0] += 1)

    combat.advance(10.0)
    assert(combat.state == "idle", "Robot must not attack when player is away")
    combat.set_player_distance(2.0)
    combat.advance(0.016)
    assert(combat.state == "warning" and warnings[0] == 1, "Warning must precede attack")
    combat.advance(0.5)
    assert(combat.hits_taken == 0, "No damage during telegraph")
    combat.set_guard(true)
    combat.advance(0.7)
    assert(combat.hits_taken == 0 and resolved[0] == 1, "Guard must block warned attack")
    combat.advance(5.0)
    assert(combat.state == "idle" and combat.hits_taken == 0, "Long frame must not chain attacks")
    combat.set_guard(false)
    combat.advance(0.016)
    combat.advance(1.2)
    assert(combat.hits_taken == 1, "Unblocked hit must count exactly once")
    combat.advance(1.1)
    combat.set_player_distance(10.0)
    combat.advance(0.016)
    combat.advance(1.2)
    assert(combat.hits_taken == 1, "Leaving range must prevent hit")
    assert(not combat.player_attack(5.0), "Cannot attack beyond range")
    assert(combat.player_attack(1.0), "Close attack should damage robot")
    assert(combat.health == 2, "Robot health should decrease")
    assert(combat.player_attack(1.0))
    assert(combat.player_attack(1.0))
    assert(combat.state == "defeated" and defeats[0] == 1, "Defeat emitted once")
    assert(not combat.player_attack(1.0), "No repeat reward after defeat")
    combat.advance(20.0)
    assert(combat.hits_taken == 1 and defeats[0] == 1, "Defeated robot stays inert")
    combat.reset()
    assert(combat.health == 3 and combat.state == "idle" and combat.hits_taken == 0, "Retry resets encounter")
    print("ADVENTURE ROBOT COMBAT STATE TEST PASSED")
    quit(0)
